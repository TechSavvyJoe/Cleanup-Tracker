# MongoDB Configuration
# For production, use MongoDB Atlas or a managed MongoDB instance
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/cleanup-tracker?retryWrites=true&w=majority

# JWT Secret - MUST BE CHANGED IN PRODUCTION
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-256-bit-secret-here-CHANGE-THIS-IN-PRODUCTION

# Server Configuration
PORT=5051
NODE_ENV=production

# Google Sheets CSV URL for inventory sync (optional)
INVENTORY_CSV_URL=https://docs.google.com/spreadsheets/d/e/YOUR-SHEET-ID/pub?output=csv

# API Configuration
API_TIMEOUT=30000

# Rate Limiting (requests per 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration (optional - restrict to your domain)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
