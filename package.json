{
  "name": "cleanup-tracker-monorepo",
  "private": true,
  "workspaces": [
    "cleanup-tracker-app/client"
  ],
  "scripts": {
  "dev:client": "npm run start --workspace=cleanup-tracker-client",
  "build": "npm run build --workspace=cleanup-tracker-client",
  "dev:server": "npx wrangler@4 pages dev cleanup-tracker-app/client/build --compatibility-date=2023-05-18 --local --port=8788",
  "start:server": "npm run dev:server",
  "dev:all": "npm run build --workspace=cleanup-tracker-client && npx wrangler@4 pages dev cleanup-tracker-app/client/build --compatibility-date=2023-05-18 --local --port=8788"
  },
  "devDependencies": {
  "wrangler": "^4.35.0"
  }
}
